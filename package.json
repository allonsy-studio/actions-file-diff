{
	"$schema": "https://www.schemastore.org/package.json",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"name": "@allons-y/actions-file-diff",
	"version": "0.0.0",
	"description": "Compare compiled assets between branches and report the diff back on the pull request.",
	"license": "Apache-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.llc)",
	"homepage": "https://github.com/castastrophe/actions-file-diff#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/castastrophe/actions-file-diff.git"
	},
	"bugs": {
		"url": "https://github.com/castastrophe/actions-file-diff/issues"
	},
	"type": "module",
	"main": "index.js",
	"files": [
		"index.js",
		"utilities.js",
		"action.yml"
	],
	"scripts": {
		"ci": "yarn lint",
		"coverage": "jest --coverage",
		"format": "yarn lint --fix",
		"lint": "eslint --no-error-on-unmatched-pattern --no-warn-ignored --cache '**/*'",
		"precommit": "lint-staged",
		"prepare": "husky && envoy || true",
		"semantic-release": "yarn ci && semantic-release",
		"test": "jest --experimental-vm-modules"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@actions/glob": "^0.7.0"
	},
	"devDependencies": {
		"@allons-y/toolkit": "^0.1.0",
		"@allons-y/envoy": "^1.1.0",
		"@commitlint/cli": "^21.0.1",
		"eslint": "^10.3.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.0.4",
		"prettier": "^3.0.0",
		"semantic-release": "^25.0.3",
		"typescript": "^6.0.3"
	},
	"keywords": [
		"actions",
		"diff",
		"file-size",
		"github",
		"pull-request"
	],
	"engines": {
		"node": ">=24"
	},
	"lint-staged": {
		"*": [
			"eslint --fix --format stylish"
		],
		".github/renovate.json": "npx --yes --package renovate -- renovate-config-validator --strict"
	},
	"packageManager": "yarn@4.14.1"
}
