{
	"$schema": "https://www.schemastore.org/package.json",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"name": "@allons-y/actions-file-diff",
	"version": "0.0.0",
	"description": "Compare compiled assets between branches and report the diff back on the pull request.",
	"license": "MPL-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/castastrophe/actions-file-diff#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/castastrophe/actions-file-diff.git"
	},
	"bugs": {
		"url": "https://github.com/castastrophe/actions-file-diff/issues"
	},
	"type": "module",
	"main": "src/index.js",
	"files": [
		"src/index.js",
		"src/utilities.js",
		"action.yml"
	],
	"scripts": {
		"changeset": "changeset",
		"ci": "yarn lint",
		"coverage": "jest --coverage",
		"format": "prettier --write . && yarn lint --fix",
		"lint": "eslint --no-error-on-unmatched-pattern --no-warn-ignored --cache '**/*'",
		"precommit": "lint-staged",
		"prepare": "husky && envoy || true",
		"release": "changeset publish",
		"test": "jest --experimental-vm-modules",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@actions/glob": "^0.7.0"
	},
	"devDependencies": {
		"@allons-y/envoy": "^1.1.0",
		"@changesets/cli": "^2.31.0",
		"@changesets/get-github-info": "^0.8.0",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.0",
		"@eslint/markdown": "^8.0.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.15.3",
		"eslint-plugin-jsonc": "^3.2.0",
		"eslint-plugin-node": "^11.1.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.0.8",
		"prettier": "^3.8.5"
	},
	"keywords": [
		"actions",
		"diff",
		"file-size",
		"github",
		"pull-request"
	],
	"engines": {
		"node": ">=24"
	},
	"lint-staged": {
		"*": [
			"prettier --write --ignore-unknown",
			"eslint --fix --format stylish"
		],
		".github/renovate.json": "npx --yes --package renovate -- renovate-config-validator --strict"
	},
	"packageManager": "yarn@4.17.0"
}
